# Copy to .env.local and fill in. Never commit real values.

# Public site address, used for canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API. These two are safe for browsers, because
# row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key. SERVER ONLY: bypasses row level security.
# Never give it a NEXT_PUBLIC_ prefix, and never use it in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary. Server only: these must never start with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend. Server only: these must never start with NEXT_PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM=
# Development only: every email goes to this address instead of the real recipient.
EMAIL_TEST_RECIPIENT=
# Production only: set to true, and leave EMAIL_TEST_RECIPIENT blank, to email real recipients.
EMAIL_LIVE_SENDING=
# The password the host's scheduler uses to run the email worker. Long and random. Not needed on your own computer.
JOBS_WORKER_SECRET=
# Signs Supabase's requests to send account emails. Set in the host and in the Supabase dashboard's Auth Hooks.
SEND_EMAIL_HOOK_SECRET=
# Resend's webhook signing secret (starts with whsec_), for spam and bounce reports to
# /api/v1/email/events. Set the webhook up in the Resend dashboard before launch.
RESEND_WEBHOOK_SECRET=
# Scrambles addresses in the Contact Seller log and rate limits. Long and random.
CONTACT_HASH_SECRET=

# Phone notifications: generate with npx web-push generate-vapid-keys. The private key stays on the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
